<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Single application theme. AppCompat is used because the project is
        written in Java; the action bar is disabled so that the banner image
        can start directly below the status bar (see Figures 3 and 4).
    -->
    <style name="Theme.CampusLife" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorPrimaryDark">@color/green</item>
        <item name="colorAccent">@color/light_green</item>
        <item name="android:windowBackground">@color/content_background</item>
    </style>
</resources>
